{
  "name": "@indiefoundry/newrelic-mcp",
  "version": "1.0.0",
  "description": "MCP server for querying New Relic observability data via NRQL",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "newrelic-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/indiefoundry/newrelic-mcp.git"
  },
  "keywords": [
    "mcp",
    "new-relic",
    "nrql",
    "observability",
    "model-context-protocol"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
